# Local development environment for safe-npm / safe-npx.
# Copy this file to `.env` and adjust as needed. Do not commit `.env`.

# --- Registry API ---
SAFE_NPM_API_HOST=0.0.0.0
SAFE_NPM_API_PORT=3000
SAFE_NPM_API_BASE_URL=http://localhost:3000

# --- PostgreSQL ---
SAFE_NPM_DB_HOST=localhost
SAFE_NPM_DB_PORT=5432
SAFE_NPM_DB_NAME=safenpm
SAFE_NPM_DB_USER=safenpm
SAFE_NPM_DB_PASSWORD=safenpm
SAFE_NPM_DB_URL=postgresql://safenpm:safenpm@localhost:5432/safenpm

# --- Redis ---
SAFE_NPM_REDIS_HOST=localhost
SAFE_NPM_REDIS_PORT=6379
SAFE_NPM_REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO / S3-compatible) ---
SAFE_NPM_OBJECT_STORE_ENDPOINT=http://localhost:9000
SAFE_NPM_OBJECT_STORE_REGION=us-east-1
SAFE_NPM_OBJECT_STORE_ACCESS_KEY=safenpm
SAFE_NPM_OBJECT_STORE_SECRET_KEY=safenpmpassword
SAFE_NPM_OBJECT_STORE_BUCKET=safenpm-tarballs
SAFE_NPM_OBJECT_STORE_FORCE_PATH_STYLE=true

# --- Public npm proxy ---
SAFE_NPM_PUBLIC_REGISTRY=https://registry.npmjs.org

# --- Signing (local dev only; production uses KMS) ---
SAFE_NPM_SIGNING_KEY_PATH=./.dev-keys/ecdsa-p256.pem
SAFE_NPM_SIGNING_KEY_ID=dev-local

# --- Auth ---
SAFE_NPM_JWT_SECRET=dev-local-secret-change-me
SAFE_NPM_DEV_ADMIN_USERNAME=devadmin
SAFE_NPM_DEV_ADMIN_TOKEN=dev-local-admin-token

# --- Telemetry ---
SAFE_NPM_TELEMETRY_ENABLED=true
