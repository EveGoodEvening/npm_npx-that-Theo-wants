{
  "name": "safe-npm-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Compatibility-first package registry and CLI layer (safe-npm / safe-npx)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run build && npm run lint && npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
