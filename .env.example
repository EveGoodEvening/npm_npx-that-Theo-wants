# Local development environment for safe-npm / safe-npx
# Copy to .env and adjust as needed.

# Registry API
SAFE_NPM_API_HOST=127.0.0.1
SAFE_NPM_API_PORT=7480
SAFE_NPM_API_BASE_URL=http://127.0.0.1:7480

# PostgreSQL
SAFE_NPM_DB_URL=postgres://safenpm:safenpm_dev@127.0.0.1:5432/safenpm

# Redis
SAFE_NPM_REDIS_URL=redis://127.0.0.1:6379

# Object storage (MinIO local / S3-compatible)
SAFE_NPM_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
SAFE_NPM_OBJECT_STORE_REGION=us-east-1
SAFE_NPM_OBJECT_STORE_ACCESS_KEY=safenpm
SAFE_NPM_OBJECT_STORE_SECRET_KEY=safenpm_dev
SAFE_NPM_OBJECT_STORE_BUCKET=safenpm-tarballs
SAFE_NPM_OBJECT_STORE_FORCE_PATH_STYLE=true

# Public npm registry (proxy/cache source)
SAFE_NPM_PUBLIC_REGISTRY=https://registry.npmjs.org

# Local dev signing key path (generated, never committed)
SAFE_NPM_DEV_SIGNING_KEY_PATH=./dev-signing-key.pem

# Telemetry
SAFE_NPM_TELEMETRY_ENABLED=false
